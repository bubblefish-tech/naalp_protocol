# Go
*.test
*.out
# Compiled binaries (runner + adapters + worked-example are built, never committed)
*.exe
harness/runner/naalp-conform
harness/runner/naalp-conform-linux
harness/adapters/go/naalp-adapter-go
harness/adapters/rust/target/
# Rust
impl/rust/target/
# Additional-language SDK build artifacts (rebuilt/downloaded by harness/cross_language.sh + CI)
node_modules/
harness/adapters/java/out/
harness/adapters/java/lib/
harness/adapters/kotlin/lib/
harness/adapters/**/vendor/
harness/adapters/**/.build/
harness/adapters/**/bin/
harness/adapters/**/obj/
*.class
*.jar
# .NET SDK build outputs (impl/csharp is the only .NET project; adapters/**/bin|obj covered above)
impl/csharp/bin/
impl/csharp/obj/
impl/swift/.build/
harness/adapters/swift_adapter/.build/
# Stray local logs / scratch (not part of the build)
tracker.log
**/tracker.log
.local/
# Python
__pycache__/
*.pyc
.venv/
# mkdocs
site/
# IETF submission folder (ietf/): the submittable .xml/.txt/.html ARE committed — they are the
# artifacts an actual submission uploads/attaches. Only the fetched reference cache and the
# tool error logs are ignored (regenerated by kramdown-rfc/xml2rfc on build).
ietf/.refcache/
ietf/*.err
# OS
.DS_Store
Thumbs.db
