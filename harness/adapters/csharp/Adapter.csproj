<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>naalp-adapter-csharp</AssemblyName>
    <RootNamespace>Naalp.Adapter</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Real Unicode normalization (ICU) is REQUIRED: the nfc.check op relies on
         String.IsNormalized, which is a no-op under globalization-invariant mode and would
         silently accept non-NFC input. Keep invariant OFF so the NFC check actually runs. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../impl/csharp/Bubblefish.Naalp.csproj" />
  </ItemGroup>

</Project>
